{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "deep-cuts",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "ai": {
    "binding": "AI"
  },
  "ratelimits": [
    {
      "name": "ANALYTICS_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "SALES_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "SALES_RESEARCH_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 4,
        "period": 60
      }
    }
  ],
  "vars": {
    "SALES_DAILY_REQUEST_LIMIT": "100",
    "PRODUCTION_HOST": "deep-cuts.andrewharris501.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "deep-cuts-production",
      "database_id": "dd494d36-4300-4946-854b-11a16d65bb1a",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
